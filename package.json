{
  "name": "DjordjeNedovic-Dev-blog",
  "version": "2.0.2",
  "private": true,
  "scripts": {
    "start": "next dev  --webpack",
    "dev": "cross-env next dev",
    "build": "cross-env next build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint:fix": "next lint --fix",
    "prettier:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && next lint"
  },
  "dependencies": {
    "@next/bundle-analyzer": "14.2.30",
    "@next/third-parties": "^14.2.30",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint-config-next": "14.2.30",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.14.0",
    "next": "14.2.30",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "prismjs": "^1.30.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "reading-time": "^1.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.0",
    "velite": "^0.3.1"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "25.9.2",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "@opentelemetry/api": "1.4.1",
    "@opentelemetry/core": "1.13.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.39.1",
    "@opentelemetry/resources": "1.13.0",
    "@opentelemetry/sdk-trace-base": "1.13.0",
    "@opentelemetry/sdk-trace-node": "1.13.0",
    "@opentelemetry/semantic-conventions": "1.13.0",
    "kbar": "0.1.0-beta.44",
    "mdast-util-gfm-table": "1.0.7",
    "mdast-util-gfm": "2.0.2"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@3.6.1"
}
